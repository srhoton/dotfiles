#!/usr/bin/env python3
"""impl-plan-render: turn a scored /impl-plan plan.json into an HTML page.

Usage: impl-plan-render PLAN.json > index.html

The plan must already be scored by `impl-plan-status --write` (every step needs `status`).
Output on stdout is an HTML fragment for the claude.ai Artifact publisher (it adds the
doctype/head/body): <title>, inline CSS, a Google Fonts stylesheet and no scripts. The layout and tokens follow the Grow/svo coupling plan artifact. Status colours:
green --ok (completed), yellow --pr (PR out), orange --gate (design gate), red --risk (not
started); each is a left border, a soft background and the pill text, and the pill says it in
words. Every string from the plan is HTML-escaped; backtick spans become <code>.

Exit 0 rendered, 2 unreadable or invalid plan, or a step without a status (names the field).
Standard library only. Tests: bin/tests/impl-plan-render.sh.
"""

from __future__ import annotations

import html
import importlib.machinery
import importlib.util
import os
import re
import sys
from typing import Any

JIRA = "https://fullbay.atlassian.net/browse/"
GITHUB = "https://github.com/"
STATUS_LABEL = {"green": "Completed", "yellow": "PR out", "orange": "Design gate", "red": "Not started"}
STATUS_CLASS = {"green": "s-green", "yellow": "s-yellow", "orange": "s-orange", "red": "s-red"}
PR_STATE_LABEL = {"OPEN": "open", "MERGED": "merged", "CLOSED": "closed"}

