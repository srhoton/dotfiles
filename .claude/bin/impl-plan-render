@media (prefers-reduced-motion:reduce){*{transition:none!important}}
"""


def _load_validator() -> Any:
    """The validator in impl-plan-status (one source of truth for the plan shape)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "impl-plan-status")
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("impl_plan_status", path)
    spec = importlib.util.spec_from_loader("impl_plan_status", loader)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def esc(text: Any) -> str:
    return html.escape(str(text), quote=True)


def inline(text: str) -> str:
    """Escaped text with `backtick` spans as <code>."""
    out = esc(text)
    return re.sub(r"`([^`\n]+)`", lambda m: f"<code>{m.group(1)}</code>", out)


def rich(text: str) -> str:
    """Paragraphs on blank lines; consecutive "- " or "* " lines become a list."""
    blocks: list[str] = []
    for chunk in re.split(r"\n\s*\n", text.strip()):
        lines = [ln for ln in chunk.splitlines() if ln.strip()]
        para: list[str] = []
        items: list[str] = []
        for ln in lines:
            m = re.match(r"^\s*[-*]\s+(.*)$", ln)
            if m:
                _flush_para(para, blocks)
                items.append(m.group(1))
            else:
                _flush_items(items, blocks)
                para.append(ln)
        _flush_para(para, blocks)
        _flush_items(items, blocks)
    return "".join(blocks)


def _flush_para(para: list[str], blocks: list[str]) -> None:
    if para:
        blocks.append("<p>" + "<br>".join(inline(x.strip()) for x in para) + "</p>")
        para.clear()


def _flush_items(items: list[str], blocks: list[str]) -> None:
    if items:
        blocks.append("<ul>" + "".join(f"<li>{inline(x)}</li>" for x in items) + "</ul>")
        items.clear()


def ticket_chip(key: str) -> str:
    return f'<a class="chip t" href="{esc(JIRA + key)}">{esc(key)}</a>'


def pr_chip(ref: str, state: str | None) -> str:
    owner_repo, num = ref.split("#")
    cls = f" prs-{state.lower()}" if state else ""
    label = f" · {PR_STATE_LABEL[state]}" if state else ""
    return f'<a class="chip pr{cls}" href="{esc(f"{GITHUB}{owner_repo}/pull/{num}")}">{esc(ref)}{label}</a>'


def render_step(s: dict[str, Any], open_qs: dict[str, list[str]]) -> str:
    sid = s["id"]
    status = s["status"]
    cls = STATUS_CLASS[status]
    gate = s.get("designGate") or {}
    pr_states = s.get("prStates", {})
    chips = [ticket_chip(k) for k in s.get("tickets", [])]
    chips += [pr_chip(r, pr_states.get(r)) for r in s.get("prs", [])]
    if gate.get("required"):
        chips.append('<span class="chip gate">design gate'
                     + (f" approved {esc(gate['approved'])}" if gate.get("approved") else " not approved") + "</span>")
    pills = f'<span class="spill">{STATUS_LABEL[status]}</span>'
    if s.get("stale"):
        pills += '<span class="spill stale">stale</span>'
    rows = [("Work", rich(s["work"]))]
    repos = []
    for r in s["repos"]:
        new = '' if r["exists"] else ' <span class="chip new">new</span>'
        repos.append(f'<span class="chip">{esc(r["name"])}</span>{new}')
    rows.append(("Repos", '<div class="chips">' + "".join(repos) + "</div>" if repos else "None"))
    rows.append(("Plain English", f'<p class="plain">{inline(s["plain"])}</p>'))
    if s.get("dependsOn"):
        links = "".join(f'<a class="chip dep" href="#step-{esc(d)}">{esc(d)}</a>' for d in s["dependsOn"])
        rows.append(("Depends on", f'<div class="chips">{links}</div>'))
    if s.get("prerequisites"):
        rows.append(("Prerequisites", "<ul>" + "".join(f"<li>{inline(x)}</li>" for x in s["prerequisites"]) + "</ul>"))
    if gate.get("required"):
        verdict = f"approved {gate['approved']}" if gate.get("approved") else "not approved"
        rows.append(("Design gate", f"<p>{inline(gate['reason'])} ({esc(verdict)})</p>"))
    if open_qs.get(sid):
        links = "".join(f'<a class="chip dep" href="#q-{esc(q)}">{esc(q)}</a>' for q in open_qs[sid])
        rows.append(("Blocked by", f'<div class="chips">{links}</div>'))
    if s.get("statusNote"):
        rows.append(("Note", f"<p>{inline(s['statusNote'])}</p>"))
    kv = "".join(f"<dt>{esc(k)}</dt><dd>{v}</dd>" for k, v in rows)
    why = f'<p class="why">{inline(s["statusWhy"])}</p>' if s.get("statusWhy") else ""
    return (f'<div class="step {cls}" id="step-{esc(sid)}"><div class="sid">{esc(sid)}{pills}</div>'
            f'<div class="sbody"><div class="stitle"><h3>{inline(s["title"])}</h3>'
            f'<div class="chips">{"".join(chips)}</div></div>{why}<dl class="kv">{kv}</dl></div></div>')


def render_question(q: dict[str, Any], resolved: bool) -> str:
    blocks = "".join(f'<a class="chip dep" href="#step-{esc(b)}">{esc(b)}</a>' for b in q["blocks"])
    extra = f'<p><b>Answer:</b> {inline(q["answer"])}</p>' if resolved else ""
    owner = f'<span class="owner">Owner: {esc(q["owner"])}</span>' if q.get("owner") else ""
    blocked = f'<div class="chips"><span class="owner">Blocks:</span>{blocks}</div>' if blocks else ""
    return (f'<li id="q-{esc(q["id"])}"><span class="qid">{esc(q["id"])}</span><p>{inline(q["question"])}</p>'
            f'{extra}{blocked}{owner}</li>')


def render(doc: dict[str, Any]) -> str:
    meta = doc["plan"]
    steps: list[dict[str, Any]] = doc["steps"]
    questions: list[dict[str, Any]] = doc["questions"]
    open_qs: dict[str, list[str]] = {}
    for q in questions:
        if q["status"] == "open":
            for b in q["blocks"]:
                open_qs.setdefault(b, []).append(q["id"])

    src = meta["source"]
    eyebrow = " · ".join(x for x in (
        "Implementation plan",
        f"updated {meta['updatedAt']}" if meta.get("updatedAt") else "",
        f"source: {src['kind']}" + (f" {src['ref']}" if src["ref"] else "")) if x)
    epics = "".join(f"<span>Epic {ticket_chip(k)}</span>" for k in meta.get("epics", []))
    head = (f'<header><span class="eyebrow">{esc(eyebrow)}</span><h1>{inline(meta["title"])}</h1>'
            f'<p>{inline(meta["summary"])}</p>' + (f'<div class="meta">{epics}</div>' if epics else "") + "</header>")

    decisions = ""
    if meta.get("decisions"):
        items = "".join(f"<li><b>{inline(d['title'])}</b><span>{inline(d['detail'])}</span></li>" for d in meta["decisions"])
        decisions = f'<section><h2>What is decided</h2><ul class="decisions">{items}</ul></section>'

    counts = {c: sum(1 for s in steps if s["status"] == c) for c in STATUS_CLASS}
    strip = '<span class="sep">·</span>'.join(
        f'<span class="cnt {STATUS_CLASS[c]}"><b>{n}</b> {c}</span>' for c, n in counts.items())
    legend = "".join(f'<span><i class="sw {STATUS_CLASS[c]}"></i>{c.capitalize()}: {label}</span>' for c, label in (
        ("green", "completed"), ("yellow", "PR out, not finished"),
        ("orange", "design gate, needs a design and review before code"), ("red", "not started")))
    warns = doc.get("warnings") or []
    callout = ""
    if warns:
        callout = ('<aside class="callout" role="note" aria-label="Warnings"><b>Warnings</b><ul>'
                   + "".join(f"<li>{inline(w)}</li>" for w in warns) + "</ul></aside>")
    status_sec = (f'<section><h2>Where it stands</h2><div class="counts" role="status">{strip}</div>'
                  f'<div class="legend" role="note" aria-label="Status colour key">{legend}</div>{callout}</section>')

    phases = []
    for ph in doc["phases"]:
        mine = [s for s in steps if s["phase"] == ph["id"]]
        done = sum(1 for s in mine if s["status"] == "green")
        body = "".join(render_step(s, open_qs) for s in mine) or '<div class="empty">No steps in this phase.</div>'
        note = f"<p>{inline(ph['note'])}</p>" if ph.get("note") else ""
        phases.append(f'<div class="phase" id="phase-{esc(ph["id"])}"><div class="phase-head"><h3>{inline(ph["title"])}</h3>'
                      f'{note}<span class="prog">{done} of {len(mine)} completed</span></div>{body}</div>')
    path = ('<section><h2>Implementation path</h2><p>Each step names its tickets and PRs, the repos, what changes, and '
            'what it means in plain terms. The pill and the coloured edge show its status.</p>'
            + "".join(phases) + "</section>")

    openq = [q for q in questions if q["status"] == "open"]
    doneq = [q for q in questions if q["status"] == "resolved"]
    qhtml = '<section><h2>Open questions</h2>'
    qhtml += (f'<div class="box"><ul class="qs">{"".join(render_question(q, False) for q in openq)}</ul></div>'
              if openq else "<p>No open questions.</p>")
    if doneq:
        qhtml += (f'<details><summary>Resolved ({len(doneq)})</summary><ul class="qs">'
                  f'{"".join(render_question(q, True) for q in doneq)}</ul></details>')
    qhtml += "</section>"

    return (
        # A fragment, not a document: the claude.ai Artifact publisher supplies the doctype,
        # html, head and body (with charset and viewport-fit=cover). Keep <title> first.
        f"<title>{esc(meta['title'])}</title>\n"
        '<meta name="claude:viewport-fit-sides" content="cover">'
        '<link rel="preconnect" href="https://fonts.googleapis.com">'
        '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700'
        '&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">'
        f"<style>{CSS}</style>\n"
        f'<div class="wrap">\n{head}\n{decisions}\n{status_sec}\n{path}\n{qhtml}\n</div>\n')


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0].startswith("-"):
        print("usage: impl-plan-render PLAN.json > index.html", file=sys.stderr)
        return 2
    mod = _load_validator()
    try:
        doc = mod.load(argv[0])
        for i, s in enumerate(doc["steps"]):
            if "status" not in s:
                raise mod.ValidationError(f"steps[{i}].status: is missing; run impl-plan-status --write first")
    except mod.ValidationError as e:
        print(f"impl-plan-render: {e}", file=sys.stderr)
        return 2
    sys.stdout.write(render(doc))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
