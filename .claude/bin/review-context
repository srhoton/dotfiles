#!/bin/bash
#
# review-context - the git context a reviewer needs, in one call.
#
# Replaces the hand-run `git log master..HEAD; git diff master...HEAD --stat;
# cat defect-classes.md` sequence and /review's changed-file detection.
#
# Usage:
#   review-context [--base BRANCH] [--files-only] [--no-defects] [-C DIR]
#   review-context --diff [-U N] [FILE...] [--base BRANCH] [-C DIR]
#
#   --base BRANCH   compare against BRANCH (a local ref, else origin/BRANCH).
#                   Default: the branch origin/HEAD points at, else master, else main;
#                   the default prefers origin/<branch> over a possibly stale local one.
#   --files-only    print ONLY the deduped changed-file list, one path per line,
#                   relative to the repo root (for feeding the review workflow).
#   --diff          print ONLY the numbered diff: the merge base against the working tree
#                   (committed + staged + unstaged), plus untracked files as all-added.
#                   Each line is `<new-file line>| +added` / `<line>|  context`; deleted
#                   lines are `    -| -text`. Per file `=== path (+A -D) ===`; binary files
#                   `path: binary file changed`. Not truncated. FILE... (paths relative to
#                   the repo root) restricts it; a path that is not changed exits 3.
#   -U N            context lines around each change in --diff (default 3)
#   --no-defects    omit the defect-classes checklist (path: $DEFECT_CLASSES, default
#                   ~/.claude/knowledge/defect-classes.md)
#   -C DIR          run as if started in DIR
#   -h, --help      this text
#
# Output: repo root, branch, base, merge-base; commits on the branch; branch diff
# stat; uncommitted (staged / unstaged / untracked) stat; CHANGED FILES = dedup of
# base...HEAD + unstaged + staged + untracked, minus files that no longer exist on
# disk (those are listed separately as DELETED); then the defect classes.
#
# Exit 0 = ok (an unresolvable base only warns on stderr and skips the branch
# diff). Exit 2 = not in a git repo, or bad usage. Exit 3 = --diff FILE that is not
# a changed path. Read-only.

set -uo pipefail

BASE_ARG=""
FILES_ONLY=0
NO_DEFECTS=0
DIFF=0
CONTEXT_LINES=""
DIFF_FILES=()
DIR=""

usage() { awk 'NR >= 2 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --base)       [ $# -ge 2 ] || { echo "review-context: --base needs a value" >&2; exit 2; }
                  BASE_ARG="$2"; shift 2 ;;
    --files-only) FILES_ONLY=1; shift ;;
    --no-defects) NO_DEFECTS=1; shift ;;
    --diff)       DIFF=1; shift ;;
    -U)           [ $# -ge 2 ] || { echo "review-context: -U needs a value" >&2; exit 2; }
                  CONTEXT_LINES="$2"; shift 2 ;;
    -U[0-9]*)     CONTEXT_LINES="${1#-U}"; shift ;;
    -C)           [ $# -ge 2 ] || { echo "review-context: -C needs a value" >&2; exit 2; }
                  DIR="$2"; shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; DIFF_FILES+=("$@"); break ;;
    -*)           echo "review-context: unknown argument: $1 (see --help)" >&2; exit 2 ;;
    *)            DIFF_FILES+=("$1"); shift ;;
  esac
done

if [ "$DIFF" -eq 0 ] && { [ -n "$CONTEXT_LINES" ] || [ "${#DIFF_FILES[@]}" -gt 0 ]; }; then
  echo "review-context: -U and FILE arguments need --diff (see --help)" >&2; exit 2
fi
if [ "$DIFF" -eq 1 ] && [ "$FILES_ONLY" -eq 1 ]; then
  echo "review-context: --diff and --files-only are mutually exclusive" >&2; exit 2
fi
case "${CONTEXT_LINES:-0}" in
  *[!0-9]*) echo "review-context: -U needs a non-negative integer, got '$CONTEXT_LINES'" >&2; exit 2 ;;
esac

# Resolved before any cd, and through symlinks, so a PATH-invoked or symlinked script finds lib/.
NUMBERED_DIFF=""
if [ "$DIFF" -eq 1 ]; then
  NUMBERED_DIFF="$(python3 -c 'import os, sys; print(os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "lib", "numbered_diff.py"))' "${BASH_SOURCE[0]}")" || exit 2
fi

if [ -n "$DIR" ]; then
  cd "$DIR" 2>/dev/null || { echo "review-context: cannot cd to $DIR" >&2; exit 2; }
fi
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "review-context: not inside a git repository" >&2; exit 2; }
cd "$ROOT" || exit 2

# ---- resolve the base ---------------------------------------------------------
# Name the user asked for (or detected); BASE_REF is what git can actually resolve.
# An explicit --base is taken literally (local ref first). A detected default prefers
# origin/<name>: a local master that lags origin would otherwise drag already-merged
# commits into the branch log and diff.
resolve_ref() {
  local name="$1" prefer_origin="${2:-0}" first second
  if [ "$prefer_origin" -eq 1 ]; then first="origin/$name"; second="$name"; else first="$name"; second="origin/$name"; fi
  if git rev-parse --verify -q "$first^{commit}" >/dev/null 2>&1; then echo "$first"
  elif git rev-parse --verify -q "$second^{commit}" >/dev/null 2>&1; then echo "$second"
  fi
}

BASE_NAME="$BASE_ARG"
BASE_REF=""
if [ -n "$BASE_NAME" ]; then
  BASE_REF="$(resolve_ref "$BASE_NAME")"
else
  BASE_NAME="$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')"
  [ -n "$BASE_NAME" ] && BASE_REF="$(resolve_ref "$BASE_NAME" 1)"
  if [ -z "$BASE_REF" ]; then
    for cand in master main; do
      BASE_REF="$(resolve_ref "$cand" 1)"
      if [ -n "$BASE_REF" ]; then BASE_NAME="$cand"; break; fi
    done
  fi
fi
if [ -z "$BASE_REF" ]; then
  echo "review-context: WARN base branch '${BASE_NAME:-master/main}' not found; branch diff skipped, listing working-tree changes only" >&2
fi

# ---- collect changed paths (NUL-safe) ----------------------------------------
# name-status with --no-renames: a rename is a delete of the old path plus an add of
# the new one, so the old path is reported as deleted and the new one as changed.
CANDIDATES=()
add_name_status() {
  local status path
  while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    CANDIDATES+=("$path")
  done
}

if [ -n "$BASE_REF" ]; then
  add_name_status < <(git diff --name-status -z --no-renames "$BASE_REF"...HEAD 2>/dev/null)
fi
add_name_status < <(git diff --name-status -z --no-renames 2>/dev/null)
add_name_status < <(git diff --cached --name-status -z --no-renames 2>/dev/null)
while IFS= read -r -d '' path; do CANDIDATES+=("$path"); done \
  < <(git ls-files --others --exclude-standard -z 2>/dev/null)

CHANGED=()
DELETED=()
if [ "${#CANDIDATES[@]}" -gt 0 ]; then
  while IFS= read -r -d '' path; do
    if [ -e "$path" ] || [ -L "$path" ]; then CHANGED+=("$path"); else DELETED+=("$path"); fi
  done < <(printf '%s\0' "${CANDIDATES[@]}" | LC_ALL=C sort -zu)
fi

if [ "$FILES_ONLY" -eq 1 ]; then
  [ "${#CHANGED[@]}" -eq 0 ] || printf '%s\n' "${CHANGED[@]}"
  exit 0
fi

# ---- --diff: the numbered diff, nothing else ------------------------------------
if [ "$DIFF" -eq 1 ]; then
  for want in ${DIFF_FILES[@]+"${DIFF_FILES[@]}"}; do
    known=0
    for have in ${CHANGED[@]+"${CHANGED[@]}"} ${DELETED[@]+"${DELETED[@]}"}; do
      [ "$have" = "${want#./}" ] && { known=1; break; }
    done
    if [ "$known" -eq 0 ]; then
      echo "review-context: not a changed path (relative to $ROOT): $want" >&2; exit 3
    fi
  done

  # The merge base is what `base...HEAD` diffs from; the working tree is the other side,
  # so committed, staged and unstaged changes (and tracked deletions) all appear once.
  FROM=""
  if [ -n "$BASE_REF" ]; then FROM="$(git merge-base "$BASE_REF" HEAD 2>/dev/null)"; fi
  if [ -z "$FROM" ]; then
    [ -z "$BASE_REF" ] || echo "review-context: WARN no merge base with $BASE_REF; diffing against HEAD" >&2
    FROM="$(git rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null || git hash-object -t tree /dev/null)"
  fi

  ONLY=()
  for want in ${DIFF_FILES[@]+"${DIFF_FILES[@]}"}; do ONLY+=(--only "${want#./}"); done

  # Explicit prefixes and no external/textconv drivers, so a user's diff.noprefix,
  # diff.mnemonicPrefix or color config cannot change what the parser sees.
  GIT_DIFF=(git -c core.quotepath=off diff --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ "-U${CONTEXT_LINES:-3}")
  RAW="$(mktemp)" || exit 1
  trap 'rm -f "$RAW"' EXIT
  "${GIT_DIFF[@]}" -M "$FROM" > "$RAW" || { echo "review-context: git diff failed" >&2; exit 1; }
  # Untracked files are not in `git diff`; diff each against /dev/null so it renders as all-added.
  # --no-index exits 1 when the files differ, which is the expected case.
  while IFS= read -r -d '' path; do
    [ -d "$path" ] && [ ! -L "$path" ] && continue
    if [ "${#DIFF_FILES[@]}" -gt 0 ]; then
      keep=0
      for want in "${DIFF_FILES[@]}"; do [ "${want#./}" = "$path" ] && keep=1; done
      [ "$keep" -eq 1 ] || continue
    fi
    "${GIT_DIFF[@]}" --no-index -- /dev/null "$path" >> "$RAW"
    [ $? -le 1 ] || { echo "review-context: git diff failed for untracked file $path" >&2; exit 1; }
  done < <(git ls-files --others --exclude-standard -z)
  python3 "$NUMBERED_DIFF" ${ONLY[@]+"${ONLY[@]}"} < "$RAW"
  exit $?
fi

# ---- report -------------------------------------------------------------------
BRANCH="$(git branch --show-current 2>/dev/null)"
echo "REPO:       $ROOT"
echo "BRANCH:     ${BRANCH:-(detached HEAD)}"
if [ -n "$BASE_REF" ]; then
  MB="$(git merge-base "$BASE_REF" HEAD 2>/dev/null)"
  [ -n "$MB" ] && MB="$(git rev-parse --short "$MB")"
  echo "BASE:       $BASE_REF"
  echo "MERGE-BASE: ${MB:-none (unrelated histories)}"
else
  echo "BASE:       (not found: ${BASE_NAME:-master/main})"
  echo "MERGE-BASE: n/a"
fi

if [ -n "$BASE_REF" ]; then
  echo
  echo "=== COMMITS ($BASE_REF..HEAD) ==="
  LOG="$(git log --oneline "$BASE_REF"..HEAD 2>/dev/null)"
  echo "${LOG:-(none)}"
  echo
  echo "=== BRANCH DIFF STAT ($BASE_REF...HEAD) ==="
  STAT="$(git diff --stat "$BASE_REF"...HEAD 2>/dev/null)"
  echo "${STAT:-(none)}"
fi

echo
echo "=== UNCOMMITTED ==="
echo "--- staged ---"
OUT="$(git diff --cached --stat 2>/dev/null)"; echo "${OUT:-(none)}"
echo "--- unstaged ---"
OUT="$(git diff --stat 2>/dev/null)"; echo "${OUT:-(none)}"
echo "--- untracked ---"
OUT="$(git ls-files --others --exclude-standard 2>/dev/null)"; echo "${OUT:-(none)}"

echo
echo "=== CHANGED FILES (${#CHANGED[@]}) ==="
if [ "${#CHANGED[@]}" -eq 0 ]; then echo "(none)"; else printf '%s\n' "${CHANGED[@]}"; fi
if [ "${#DELETED[@]}" -gt 0 ]; then
  echo
  echo "=== DELETED (${#DELETED[@]}, not in the list above) ==="
  printf '%s\n' "${DELETED[@]}"
fi

if [ "$NO_DEFECTS" -eq 0 ]; then
  DEFECTS="${DEFECT_CLASSES:-$HOME/.claude/knowledge/defect-classes.md}"
  echo
  echo "=== DEFECT CLASSES ($DEFECTS) ==="
  if [ -r "$DEFECTS" ]; then cat "$DEFECTS"; else echo "WARN: defect-classes file not readable: $DEFECTS"; fi
fi
exit 0
