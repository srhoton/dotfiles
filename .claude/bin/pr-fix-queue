#!/bin/bash
#
# pr-fix-queue — find my own open PRs that are blocked and start a Claude Code
# session running `/fixit <PR#>` for each one.
#
# A PR counts as blocked when any of these hold:
#   - a reviewer's latest review is CHANGES_REQUESTED
#   - it has a merge conflict (mergeable == CONFLICTING)
#   - it has an unresolved, non-outdated review thread that a human opened and
#     whose last comment is not mine (i.e. still waiting on my reply)
#   - it has a conversation comment (top-level, not attached to a line) from a
#     human that I have not marked handled. Conversation comments have no
#     threads, so "handled" is my ROCKET reaction on the comment, placed at or
#     after its last edit. `/fixit` adds it once it has dealt with a comment;
#     add it by hand to dismiss one. No other reaction and no reply of mine
#     counts: a thumbs-up can mean "good catch, will fix", and a summary reply
#     would otherwise clear every comment above it, addressed or not.
#
# For each blocked PR:
#   - the repo's clone is DIR/<repo> (cloned if missing; skipped if its origin
#     is some other repository)
#   - a worktree is created at DIR/.pr-fix/<repo>-<PR#> on a private branch
#     pr-fix/<PR#> tracking origin/<pr head branch>. The private branch name is
#     deliberate: the main clone is often sitting on the very branch the blocked
#     PR belongs to, and `git worktree add` refuses a branch checked out
#     elsewhere. It also lets two PRs of one repo run at once. The main clone's
#     branch and uncommitted changes are never touched.
#   - inside tmux: one new window per PR, named fix-<repo>#<PR#>, running
#     claude. Outside tmux: the sessions run one after another in this terminal.
#
# The spawned session commits and PUSHES, so re-launching cannot be gated on the
# PR head SHA the way pr-review-queue does it — this tool's own push moves that
# SHA. Instead each blocking reason contributes to a SHA-independent
# fingerprint, and a PR is only relaunched when that fingerprint changes:
#   changes-requested -> the reviewer's review node id (moves when they re-review)
#   conflict          -> head oid + base oid (a conflict can only change if one moves)
#   threads           -> thread id : last comment id (my reply makes it mine, so
#                        the thread stops triggering)
#   comments          -> each unhandled comment's id @ its last-edit time, plus
#                        the id of my newest conversation comment. The second
#                        part is what lets a half-finished run recover: if
#                        /fixit replied but its reactions failed, my new reply
#                        moves the fingerprint, so the PR gets exactly one more
#                        run instead of reading as STUCK forever.
# A PR that classifies as not blocked has its state record dropped (once its
# cooldown has passed, since a running session can look clear), so the same
# blocker coming back later (a reviewer edits a handled comment, a rocket is
# removed) launches again instead of matching the old fingerprint.
# State lives in ~/.claude/state/pr-fix-queue.json ($PR_FIX_STATE overrides).
#
# Prints one line per PR ("STATUS  repo#N  detail"), then a count summary.
# Exit 1 if any PR FAILED, else 0.
#
# Usage: pr-fix-queue [-n] [-f] [-m N] [-d DIR] [-o ORG ...] [--include-bots]
#                     [--retry OWNER/REPO#N] [--clean]
#   -n              dry run: report what would launch, change nothing
#   -f              force: ignore the state file (both the cooldown and STUCK)
#                   for EVERY PR, including ones with a session still running
#   -m N            max sessions launched per run (default 2; each one pushes)
#   -d DIR          clone root (default $PR_FIX_DIR or ~/git)
#   -o ORG          only PRs in this org/owner (repeatable; default: all)
#   --include-bots  also trigger on review threads opened by bot reviewers.
#                   Never applies to conversation comments: bot comments there
#                   are status chatter ("I finished the code review").
#   --retry KEY     forget one PR's state (e.g. fullbay/some-repo#47) so it is
#                   no longer IN-FLIGHT or STUCK, then run as usual
#   --clean         remove fix worktrees whose PR is no longer open (only when
#                   clean and with nothing unpushed) and drop their state
#
# Testing: PR_FIX_QUEUE_FIXTURE=<file> reads that GraphQL response instead of
# calling GitHub, prints the classifier's plan rows, and exits before any state
# access or launch. See bin/tests/pr-fix-queue-classify.sh.

set -uo pipefail

STATE="${PR_FIX_STATE:-$HOME/.claude/state/pr-fix-queue.json}"
DIR="${PR_FIX_DIR:-$HOME/git}"
DRY=0; FORCE=0; MAX=2; CLEAN=0; ORGS=""; INCLUDE_BOTS=0; RETRY=""
COOLDOWN_HOURS=2
FIXTURE="${PR_FIX_QUEUE_FIXTURE:-}"

# The header comment is the help text: everything from line 2 to the first
# non-comment line, so it cannot fall out of step with a hardcoded line range.
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }
first_line() { printf '%s' "$1" | sed -n '1p'; }

while [ $# -gt 0 ]; do
  case "$1" in
    -n) DRY=1 ;;
    -f) FORCE=1 ;;
    -m) MAX="${2:?-m needs a number}"; shift ;;
    -d) DIR="${2:?-d needs a directory}"; DIR="${DIR/#\~/$HOME}"; shift ;;
    -o) ORGS="$ORGS ${2:?-o needs an org}"; shift ;;
    --include-bots) INCLUDE_BOTS=1 ;;
    --retry) RETRY="${2:?--retry needs OWNER/REPO#N}"; shift ;;
    --clean) CLEAN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "pr-fix-queue: unknown option '$1'" >&2; usage >&2; exit 1 ;;
  esac
  shift
done
case "$MAX" in ''|*[!0-9]*) echo "pr-fix-queue: -m needs a number" >&2; exit 1 ;; esac
if [ -n "$RETRY" ] && ! printf '%s' "$RETRY" | grep -Eq '^[^/#[:space:]]+/[^/#[:space:]]+#[0-9]+$'; then
  echo "pr-fix-queue: --retry needs OWNER/REPO#N, got '$RETRY'" >&2; exit 1
fi
if [ -n "$RETRY" ] && [ "$CLEAN" = 1 ]; then
  echo "pr-fix-queue: --retry and --clean cannot be combined" >&2; exit 1
fi

for t in gh git python3 claude; do
  command -v "$t" >/dev/null 2>&1 || { echo "pr-fix-queue: '$t' is required" >&2; exit 1; }
done

# ---- model -------------------------------------------------------------------
# The spawned session must run on opus or fable. Managed settings can pin a
# different model on a fresh session, so --model is always passed explicitly
# rather than letting the new session inherit whatever it would pick.
MODEL=$(python3 - "$HOME/.claude/settings.json" <<'MODELPY'
import json, sys
try:
    print((json.load(open(sys.argv[1])).get("model") or "").strip())
except (OSError, ValueError):
    print("")
MODELPY
)
case "$MODEL" in
  opus|fable) ;;
  *) MODEL=opus ;;
esac

WTROOT="$DIR/.pr-fix"
RESULTS=""
emit() { RESULTS="${RESULTS}$1"$'\t'"$2"$'\t'"$3"$'\n'; }

# ---- state file ---------------------------------------------------------------
# JSON object: "owner/repo#N" -> {launched_at, head_sha, fingerprint, attempts}
# Writes take an exclusive lock on a sibling .lock file (macOS has no flock(1),
# so the lock lives inside python) and land via os.replace, so readers never
# need a lock to see a consistent file.
state_get() {  # key -> "fingerprint<TAB>attempts<TAB>within_cooldown<TAB>launched_at"
  python3 - "$STATE" "$1" "$COOLDOWN_HOURS" <<'PY'
import datetime, json, sys
path, key, hours = sys.argv[1], sys.argv[2], float(sys.argv[3])
try:
    rec = json.load(open(path)).get(key) or {}
except (OSError, ValueError):
    rec = {}
fp = rec.get("fingerprint", "")
attempts = int(rec.get("attempts", 0) or 0)
within = 0
stamp = rec.get("launched_at", "")
if stamp:
    try:
        then = datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=datetime.timezone.utc)
        age = (datetime.datetime.now(datetime.timezone.utc) - then).total_seconds()
        within = 1 if age < hours * 3600 else 0
    except ValueError:
        within = 0
print("\t".join([fp, str(attempts), str(within), stamp]))
PY
}

state_put() {  # key fingerprint attempts head_sha
  python3 - "$STATE" "$1" "$2" "$3" "$4" <<'PY'
import datetime, fcntl, json, os, sys
path, key, fp, attempts, sha = sys.argv[1:6]
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path + ".lock", "a+") as lf:
    fcntl.flock(lf, fcntl.LOCK_EX)
    try:
        data = json.load(open(path))
    except (OSError, ValueError):
        data = {}
    data[key] = {
        "launched_at": datetime.datetime.now(datetime.timezone.utc)
                        .strftime("%Y-%m-%dT%H:%M:%SZ"),
        "head_sha": sha,
        "fingerprint": fp,
        "attempts": int(attempts),
    }
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
PY
}

# keep_hours > 0 leaves alone any record launched less than that long ago: its
# session may still be running, and the record is the only thing that stops a
# second session starting in the same worktree outside tmux. Pass 0 to delete
# unconditionally. Exit 3: none of the keys was removed. Exit 4: there is no
# readable state file at all. Callers that care (--retry) tell the two apart.
state_del() {  # keep_hours key [key ...]
  python3 - "$STATE" "$@" <<'PY'
import datetime, fcntl, json, os, sys
path, keep_hours, keys = sys.argv[1], float(sys.argv[2]), sys.argv[3:]
if not os.path.exists(path):
    sys.exit(4)

def in_flight(rec):
    if not keep_hours or not isinstance(rec, dict):
        return False
    try:
        then = datetime.datetime.strptime(rec.get("launched_at") or "", "%Y-%m-%dT%H:%M:%SZ"
                                          ).replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return False
    age = (datetime.datetime.now(datetime.timezone.utc) - then).total_seconds()
    return age < keep_hours * 3600

with open(path + ".lock", "a+") as lf:
    fcntl.flock(lf, fcntl.LOCK_EX)
    try:
        data = json.load(open(path))
    except (OSError, ValueError):
        sys.exit(4)
    doomed = [k for k in keys if k in data and not in_flight(data[k])]
    if not doomed:
        sys.exit(3)
    for k in doomed:
        data.pop(k)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)
PY
}

report() {
  local order="$1" st
  for st in $order; do
    printf '%s' "$RESULTS" | awk -F'\t' -v st="$st" '$1==st' \
      | awk -F'\t' '{printf "%-14s %-40s %s\n", $1, $2, $3}'
  done
  echo
  printf '%s' "$RESULTS" | awk -F'\t' -v order="$order" '{c[$1]++} END{
    n=split(order, o, " "); s="summary:";
    for(i=1;i<=n;i++) if(o[i] in c) s=s" "tolower(o[i])"="c[o[i]];
    if (s=="summary:") s=s" nothing to do"; print s}'
  printf '%s' "$RESULTS" | awk -F'\t' '$1=="FAILED"{f=1} END{exit f?1:0}'
}

# A worktree must not be discarded while it still holds work only it has.
wt_dirty()  { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }
wt_ahead()  { [ "$(git -C "$1" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" != "0" ]; }

# ---- --clean -----------------------------------------------------------------
if [ "$CLEAN" = 1 ]; then
  for wt in "$WTROOT"/*; do
    [ -d "$wt" ] || continue
    base=$(basename "$wt"); num="${base##*-}"; repo="${base%-*}"
    origin=$(git -C "$wt" remote get-url origin 2>/dev/null || true)
    slug=$(printf '%s' "$origin" | sed -nE 's#.*github\.com[:/]([^/]+/[^/]+)$#\1#p' | sed 's/\.git$//')
    if [ -z "$slug" ]; then emit SKIPPED "$base" "cannot determine repo from origin"; continue; fi
    key="$slug#$num"
    prstate=$(gh pr view "$num" -R "$slug" --json state -q .state 2>/dev/null || true)
    if [ -z "$prstate" ]; then emit SKIPPED "$key" "could not read PR state"; continue; fi
    if [ "$prstate" = "OPEN" ]; then emit KEPT "$key" "PR still open"; continue; fi
    if wt_dirty "$wt"; then
      emit KEPT "$key" "PR $prstate but worktree has uncommitted changes: $wt"; continue
    fi
    if wt_ahead "$wt"; then
      emit KEPT "$key" "PR $prstate but worktree has unpushed commits: $wt"; continue
    fi
    if [ "$DRY" = 1 ]; then emit WOULD-REMOVE "$key" "PR $prstate: $wt"; continue; fi
    if err=$(git -C "$DIR/$repo" worktree remove "$wt" 2>&1); then
      git -C "$DIR/$repo" branch -D "pr-fix/$num" >/dev/null 2>&1
      state_del 0 "$key"
      emit REMOVED "$key" "PR $prstate"
    else
      emit FAILED "$key" "worktree remove: $(first_line "$err")"
    fi
  done
  report "REMOVED WOULD-REMOVE KEPT SKIPPED FAILED"
  exit $?
fi

# ---- --retry -----------------------------------------------------------------
# -f lifts the cooldown and STUCK for every PR, which can start a second session
# on one that is still running. This forgets a single PR instead.
if [ -n "$RETRY" ] && [ -z "$FIXTURE" ]; then
  if [ "$DRY" = 1 ]; then
    echo "pr-fix-queue: would forget state for $RETRY" >&2
  else
    state_del 0 "$RETRY"
    case $? in
      0) echo "pr-fix-queue: forgot state for $RETRY" >&2 ;;
      3) echo "pr-fix-queue: no state recorded for $RETRY (check the spelling)" >&2 ;;
      *) echo "pr-fix-queue: no readable state file at $STATE — nothing to forget" >&2 ;;
    esac
  fi
fi

# ---- enumerate my blocked PRs -------------------------------------------------
QUERY='
query {
  viewer {
    login
    pullRequests(states: OPEN, first: 100) {
      nodes {
        number title isDraft updatedAt headRefOid headRefName isCrossRepository
        mergeable reviewDecision
        repository { nameWithOwner name }
        baseRef { name target { oid } }
        latestReviews(first: 20) { nodes { id state } }
        reviewThreads(first: 60) {
          nodes {
            id isResolved isOutdated
            firstComment: comments(first: 1) { nodes { author { login __typename } } }
            lastComment:  comments(last: 1)  { nodes { id author { login } } }
          }
        }
        comments(last: 50) {
          totalCount
          nodes {
            databaseId createdAt lastEditedAt isMinimized
            author { login __typename }
            reactionGroups { content viewerHasReacted }
            reactions(last: 20) { nodes { content createdAt user { login } } }
          }
        }
      }
    }
  }
}'

# GitHub computes `mergeable` lazily and answers UNKNOWN until it has; the first
# query is what triggers the computation. Re-poll so a real conflict is not read
# as "no conflict".
TMP=$(mktemp) || exit 1
trap 'rm -f "$TMP"' EXIT
if [ -n "$FIXTURE" ]; then
  cp "$FIXTURE" "$TMP" || { echo "pr-fix-queue: cannot read fixture $FIXTURE" >&2; exit 1; }
fi
for attempt in 1 2 3; do
  [ -z "$FIXTURE" ] || break
  if ! OUT=$(gh api graphql -f query="$QUERY" 2>&1); then
    echo "pr-fix-queue: gh api graphql failed: $(first_line "$OUT")" >&2; exit 1
  fi
  printf '%s' "$OUT" > "$TMP"
  if ! printf '%s' "$OUT" | grep -q '"mergeable": *"UNKNOWN"'; then break; fi
  [ "$attempt" = 3 ] || sleep 2
done

PLAN=$(ORGS="$ORGS" INCLUDE_BOTS="$INCLUDE_BOTS" python3 - "$TMP" <<'PY'
import json, os, sys

with open(sys.argv[1]) as fh:
    doc = json.load(fh)
if doc.get("errors"):
    sys.stderr.write("graphql: %s\n" % doc["errors"][0].get("message", "?"))
    sys.exit(1)

me = doc["data"]["viewer"]["login"]
orgs = set(os.environ.get("ORGS", "").split())
include_bots = os.environ.get("INCLUDE_BOTS") == "1"

# 9 columns: kind slug repo num head base fingerprint head_oid detail
# Empty columns are written as "-": the shell reads these rows with IFS=tab, and
# tab is IFS whitespace, so consecutive tabs collapse and shift later columns.
def row(*cols):
    print("\t".join(str(c) if str(c) != "" else "-" for c in cols))

# A conversation comment is handled when I have a ROCKET on it that is not older
# than its last edit. reactionGroups gives exact presence; reactions(last: 20)
# gives the time. Timestamps are same-format ISO-8601 UTC, so they sort as text.
def rocketed(c):
    if not any(g.get("content") == "ROCKET" and g.get("viewerHasReacted")
               for g in c.get("reactionGroups") or []):
        return False
    mine = [r.get("createdAt") or ""
            for r in ((c.get("reactions") or {}).get("nodes") or [])
            if r.get("content") == "ROCKET" and (r.get("user") or {}).get("login") == me]
    if not mine:
        return True  # mine is older than the newest 20 reactions; presence is still exact
    return not c.get("lastEditedAt") or max(mine) >= c["lastEditedAt"]

nodes = doc["data"]["viewer"]["pullRequests"]["nodes"]
for p in sorted(nodes, key=lambda p: p.get("updatedAt") or ""):
    slug = p["repository"]["nameWithOwner"]
    repo = p["repository"]["name"]
    num = p["number"]
    if orgs and slug.split("/")[0] not in orgs:
        continue
    if p.get("isDraft"):
        continue

    labels, fp_parts = [], []

    # A thread is actionable only if a human opened it and I have not replied.
    actionable = []
    for t in (p.get("reviewThreads") or {}).get("nodes") or []:
        if t.get("isResolved") or t.get("isOutdated"):
            continue
        fc = ((t.get("firstComment") or {}).get("nodes")) or []
        lc = ((t.get("lastComment") or {}).get("nodes")) or []
        if not fc or not lc:
            continue
        if not include_bots and (fc[0].get("author") or {}).get("__typename") != "User":
            continue
        if (lc[0].get("author") or {}).get("login") == me:
            continue
        actionable.append("%s:%s" % (t["id"], lc[0]["id"]))
    if actionable:
        labels.append("%d thread(s)" % len(actionable))
        fp_parts.append("th:" + ",".join(sorted(actionable)))

    # Conversation comments: human-only even with --include-bots (see header).
    conv = p.get("comments") or {}
    unhandled, my_newest = [], 0
    for c in conv.get("nodes") or []:
        author = c.get("author") or {}
        if author.get("login") == me:
            my_newest = max(my_newest, c.get("databaseId") or 0)
            continue
        if author.get("__typename") != "User" or c.get("isMinimized"):
            continue
        if rocketed(c):
            continue
        unhandled.append("%s@%s" % (c.get("databaseId"),
                                    c.get("lastEditedAt") or c.get("createdAt") or ""))
    if unhandled:
        note = ""
        if (conv.get("totalCount") or 0) > 50:
            note = " (only newest 50 comments checked)"
        labels.append("%d comment(s)%s" % (len(unhandled), note))
        fp_parts.append("ic:" + ",".join(sorted(unhandled)))
        fp_parts.append("mr:%d" % my_newest)

    cr = sorted(r["id"] for r in ((p.get("latestReviews") or {}).get("nodes") or [])
                if r.get("state") == "CHANGES_REQUESTED")
    if p.get("reviewDecision") == "CHANGES_REQUESTED" and cr:
        labels.append("changes-requested")
        fp_parts.append("cr:" + ",".join(cr))

    base = p.get("baseRef") or {}
    base_name = base.get("name") or ""
    base_oid = ((base.get("target") or {}).get("oid")) or ""
    if p.get("mergeable") == "CONFLICTING":
        labels.append("conflict")
        fp_parts.append("cf:%s+%s" % (p["headRefOid"], base_oid))

    if not labels:
        # Never treat an unresolved mergeability as "no conflict" silently.
        if p.get("mergeable") == "UNKNOWN":
            row("SKIP", slug, repo, num, "", "", "", "",
                "mergeability still UNKNOWN after 3 polls — not classified")
        else:
            # Fully classified and not blocked: its state record can go.
            # Say so when that verdict rests on a truncated comment list.
            total = (p.get("comments") or {}).get("totalCount") or 0
            row("CLEAR", slug, repo, num, "", "", "", "",
                "not blocked" if total <= 50 else
                "%d conversation comments, only the newest 50 were checked" % total)
        continue

    head = p.get("headRefName") or ""
    title = " ".join((p.get("title") or "-").split())[:50]
    detail = ", ".join(labels) + " — " + title

    if p.get("isCrossRepository"):
        row("SKIP", slug, repo, num, "", "", "", "",
            "fork PR (isCrossRepository) — pushing to a fork is unsupported")
        continue
    if not head or head == base_name or head in ("master", "main"):
        row("SKIP", slug, repo, num, "", "", "", "",
            "head branch '%s' looks like a default branch — refusing to push" % head)
        continue

    row("CAND", slug, repo, num, head, base_name,
        "|".join(fp_parts), p["headRefOid"], detail)
PY
) || exit 1

if [ -n "$FIXTURE" ]; then
  printf '%s\n' "$PLAN"
  exit 0
fi

# Drop the state of every PR that is no longer blocked, in one locked write.
# Records still inside the cooldown are kept: a running session can make its PR
# look clear before it has finished, and that record is what holds off a second
# launch. They go on the first run after the cooldown.
CLEAR_KEYS=()
while IFS=$'\t' read -r kind slug _repo num _head _base _fp _oid detail; do
  [ "$kind" = "CLEAR" ] || continue
  CLEAR_KEYS+=("$slug#$num")
  [ "$detail" = "not blocked" ] || echo "note: $slug#$num — $detail" >&2
done <<< "$PLAN"
if [ "$DRY" = 0 ] && [ "${#CLEAR_KEYS[@]}" -gt 0 ]; then
  state_del "$COOLDOWN_HOURS" "${CLEAR_KEYS[@]}"
fi
PLAN=$(printf '%s\n' "$PLAN" | awk -F'\t' '$1!="CLEAR"')

if [ -z "$PLAN" ]; then
  echo "pr-fix-queue: none of your open PRs are blocked${ORGS:+ in:$ORGS}"
  exit 0
fi

IN_TMUX=0
[ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1 && IN_TMUX=1
LAUNCHED=0

# fd 3 carries the plan so that claude (sequential mode) keeps the terminal on stdin.
while IFS=$'\t' read -r kind slug repo num head base fp headoid detail <&3; do
  key="$slug#$num"

  if [ "$kind" = "SKIP" ]; then emit SKIPPED "$key" "$detail"; continue; fi

  clone="$DIR/$repo"; wt="$WTROOT/$repo-$num"; win="fix-$repo#$num"

  IFS=$'\t' read -r st_fp st_attempts st_within st_when <<< "$(state_get "$key")"
  if [ "$FORCE" = 0 ] && [ "$st_within" = "1" ]; then
    emit IN-FLIGHT "$key" "launched $st_when (<${COOLDOWN_HOURS}h ago) — -f to relaunch"; continue
  fi
  if [ "$FORCE" = 0 ] && [ -n "$st_fp" ] && [ "$st_fp" = "$fp" ] && [ "$st_attempts" -ge 1 ]; then
    emit STUCK "$key" "already ran on this exact input and it is still blocked — $detail"; continue
  fi
  if [ "$IN_TMUX" = 1 ] && tmux list-windows -a -F '#{window_name}' 2>/dev/null | grep -Fxq "$win"; then
    emit SKIPPED "$key" "tmux window '$win' is already open"; continue
  fi
  if [ -e "$clone" ]; then
    origin=$(git -C "$clone" remote get-url origin 2>/dev/null || true)
    case "$origin" in
      *github.com[:/]"$slug"|*github.com[:/]"$slug".git) ;;
      *) emit SKIPPED "$key" "origin mismatch in $clone: ${origin:-none}"; continue ;;
    esac
  fi
  if [ "$LAUNCHED" -ge "$MAX" ]; then
    emit DEFERRED "$key" "limit of $MAX per run reached — $detail"; continue
  fi

  if [ "$DRY" = 1 ]; then
    how="worktree $wt on pr-fix/$num"; [ -e "$clone" ] || how="clone $slug, then $how"
    emit WOULD-LAUNCH "$key" "$detail ($how)"; LAUNCHED=$((LAUNCHED + 1)); continue
  fi

  if [ ! -e "$clone" ]; then
    mkdir -p "$DIR"
    if ! err=$(git clone --quiet "git@github.com:$slug.git" "$clone" 2>&1); then
      emit FAILED "$key" "clone: $(first_line "$err")"; continue
    fi
  fi

  # Fetch the real branch refs. pull/<N>/head is read-only and lags the branch,
  # which a reviewing tool can tolerate but a pushing one cannot.
  git -C "$clone" worktree prune >/dev/null 2>&1
  if ! err=$(git -C "$clone" fetch --prune --quiet origin \
        "+refs/heads/$head:refs/remotes/origin/$head" \
        "+refs/heads/$base:refs/remotes/origin/$base" 2>&1); then
    emit FAILED "$key" "fetch $head/$base: $(first_line "$err")"; continue
  fi

  note=""
  if [ ! -e "$wt" ]; then
    mkdir -p "$WTROOT"
    if git -C "$clone" show-ref --verify --quiet "refs/heads/pr-fix/$num"; then
      err=$(git -C "$clone" worktree add --quiet "$wt" "pr-fix/$num" 2>&1)
    else
      err=$(git -C "$clone" worktree add --quiet "$wt" -b "pr-fix/$num" --track "origin/$head" 2>&1)
    fi
    if [ -n "$err" ] && [ ! -e "$wt" ]; then
      emit FAILED "$key" "worktree add: $(first_line "$err")"; continue
    fi
  fi
  # Re-point the upstream every run: the PR's head branch can change under us.
  git -C "$wt" branch --set-upstream-to "origin/$head" >/dev/null 2>&1
  git -C "$wt" config push.default nothing >/dev/null 2>&1

  if wt_dirty "$wt"; then
    note=" [worktree dirty — session told to preserve it]"
    emit DIRTY "$key" "reusing worktree with uncommitted changes: $wt"
  elif wt_ahead "$wt"; then
    note=" [worktree has unpushed commits — session pushes them first]"
  else
    git -C "$wt" merge --ff-only '@{u}' >/dev/null 2>&1
  fi

  # Push safety: the push must land on this PR's own repo. Check the configured
  # push url AND the url left after any url.<base>.insteadOf rewrite is applied,
  # since a rewrite can redirect the push somewhere else entirely.
  # Neither value is ever printed: such a rewrite commonly embeds a credential,
  # so echoing it in an error would leak the token into logs and terminals.
  push_ok=1
  for u in "$(git -C "$wt" remote get-url --push origin 2>/dev/null)" \
           "$(git -C "$wt" ls-remote --get-url origin 2>/dev/null)"; do
    case "$u" in
      *github.com[:/]"$slug"|*github.com[:/]"$slug".git) ;;
      *) push_ok=0 ;;
    esac
  done
  if [ "$push_ok" = 0 ]; then
    emit FAILED "$key" "origin does not resolve to $slug for push (url redacted)"; continue
  fi

  if [ "$IN_TMUX" = 1 ]; then
    if ! err=$(tmux new-window -d -n "$win" -c "$wt" \
          "claude --model $MODEL -n 'fix $repo#$num' '/fixit $num'" 2>&1); then
      emit FAILED "$key" "tmux new-window: $(first_line "$err")"; continue
    fi
    state_put "$key" "$fp" 1 "$headoid"
    emit LAUNCHED "$key" "window '$win' — $detail$note"
  else
    echo ">>> $key — $detail$note" >&2
    state_put "$key" "$fp" 1 "$headoid"
    (cd "$wt" && claude --model "$MODEL" -n "fix $repo#$num" "/fixit $num")
    emit LAUNCHED "$key" "ran in this terminal — $detail$note"
  fi
  LAUNCHED=$((LAUNCHED + 1))
done 3<<< "$PLAN"

# Every new worktree is a new path, so Claude Code shows its folder-trust prompt
# in each window unless WTROOT (or a parent) has been trusted. That is the
# user's call to make, so only point it out — never write the flag here.
if ! python3 - "$HOME/.claude.json" "$WTROOT" <<'PY'
import json, os, sys
try:
    projects = json.load(open(sys.argv[1])).get("projects", {})
except (OSError, ValueError):
    sys.exit(1)
path = os.path.realpath(sys.argv[2])
while True:
    if projects.get(path, {}).get("hasTrustDialogAccepted"):
        sys.exit(0)
    parent = os.path.dirname(path)
    if parent == path:
        sys.exit(1)
    path = parent
PY
then
  {
    echo "note: $WTROOT is not a trusted folder, so each fix window will stop at"
    echo "      Claude Code's 'trust this folder?' prompt. To answer it once for all"
    echo "      fix worktrees:  cd $WTROOT && claude   (accept, then exit)"
    echo
  } >&2
fi

report "LAUNCHED WOULD-LAUNCH DEFERRED IN-FLIGHT STUCK DIRTY SKIPPED FAILED"
