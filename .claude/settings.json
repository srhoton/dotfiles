{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_PROFILE": "fb-dev-non-prod/Admin"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws secretsmanager batch-get-secret-value*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * commit * -n *)",
      "Bash(git -C * commit * -n)"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:xlsx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:google-workspace": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:skill-creator": "name-only"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/tmux-on-notification.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/format-on-edit.sh",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-stale-check.sh",
            "timeout": 15000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pre-commit-checks.sh",
            "timeout": 120000
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-destructive-git.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-aws-sso.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-pr-state.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-npm-install.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*[Aa][Ww][Ss].*run_script",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-prod-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-agent-model.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/tmux-on-session-end.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/session-env-setup.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/sessionstart-envdrift.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/tmux-on-stop.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/steverhoton/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "aws-agents@agent-toolkit-for-aws": false,
    "aws-core@agent-toolkit-for-aws": false,
    "aws-data-analytics@agent-toolkit-for-aws": true,
    "discord@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "verbose": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754086649066
  },
