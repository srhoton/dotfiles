{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "formatter": true,
  "mcp": {
    "Atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all"
    },
    "Kagi": {
      "type": "local",
      "command": [
        "uvx",
        "kagimcp"
      ],
      "environment": {
        "AWS_PROFILE": "fb-dev-non-prod/Admin",
        "KAGI_API_KEY": "{env:KAGI_API_KEY}"
      }
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp"
      ],
      "environment": {
        "AWS_PROFILE": "fb-dev-non-prod/Admin"
      }
    },
    "awsknowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "harness-mcp-server": {
      "type": "local",
      "command": [
        "/Users/steverhoton/go/bin/harness-mcp-server",
        "stdio"
      ],
      "environment": {
        "AWS_PROFILE": "fb-dev-non-prod/Admin",
        "HARNESS_API_KEY": "{env:HARNESS_API_KEY}",
        "HARNESS_BASE_URL": "{env:HARNESS_BASE_URL}",
        "HARNESS_TOOLSETS": "{env:HARNESS_TOOLSETS}"
      }
    },
    "micro-status": {
      "type": "remote",
      "url": "http://127.0.0.1:7878/mcp"
    }
  }
}
